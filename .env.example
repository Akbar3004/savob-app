# Doimiy ma'lumotlar ombori (Upstash Redis / Vercel KV)
#
# Vercel'da: Dashboard -> Storage -> "Upstash for Redis" (yoki KV) ni ulang.
# Vercel bu o'zgaruvchilarni loyihaga AVTOMATIK qo'shadi — qo'lda kiritish shart emas.
#
# Lokal ishlab chiqish uchun (`vercel dev`) qiymatlarni Upstash konsolidan oling:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Muqobil nomlar (agar to'g'ridan-to'g'ri Upstash integratsiyasi ishlatilsa):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
